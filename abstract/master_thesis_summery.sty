%\maketitleコマンドの調整
\def\labname#1{\gdef\@labname{#1}}
\def\maketitle{
\begin{center}
\begin{tabular}{|l|c|c|} \hline
\makebox[54mm]{\bf 修士論文提出者氏名} &
\makebox[48mm]{\bf \@author} &
\makebox[54mm]{\bf \@labname}\\ \hline
\multicolumn{3}{|l|}{\rule{8mm}{0mm}{\bf 修士論文題名}}\\
\multicolumn{3}{|c|}{ {\large {\bf \@title}}}\\
\hline
\end{tabular}
\end{center}
}

